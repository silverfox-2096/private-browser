# Secrets -- never commit
.env
webauth-htpasswd

# Runtime state and data (created at run time)
gluetun/

# Self-hosted CreepJS build output (optional 'test' profile)
creepjs/

# CI fingerprint job (ci/fingerprint.sh): downloaded CreepJS page + results
ci/creepjs-docs/
ci/out/

# Host-controlled updater flag
maintenance/active

__pycache__/
*.pyc

# Local setup locking, interrupted secret writes, and provider configuration
.pb-setup.lock
.pb-secret-*
*.conf.wg
*.conf
*.ovpn

# Local prebuilt release selection and interrupted transition journal
.pb-release*.json
docker-compose.release.yml
