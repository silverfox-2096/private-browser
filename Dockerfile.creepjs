# Optional local fingerprint-test server. Keep the upstream image immutable, but
# apply Alpine fixes that shipped after nginx published that image.
# checkov:skip=CKV_DOCKER_2:Optional test server; fingerprint checks verify its page, and it is removed after tests
# checkov:skip=CKV_DOCKER_3:Official nginx init needs root; upstream runs request workers as nginx
FROM nginx:alpine@sha256:892bb2152464f0c5d8972593a5f5afaf8054552580b699d95f8ff4af08c2d33d
RUN apk upgrade --no-cache
